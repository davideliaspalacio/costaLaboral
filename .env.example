# ============================================================
# CostaLaboral — variables de entorno
# Copia a .env.local (desarrollo) o defínelas en Vercel (Production/Preview).
# instrumentation.ts valida esto al arrancar (lib/env.ts) sin imprimir valores.
# NUNCA subas valores reales al repositorio.
# ============================================================

# --- Supabase (OBLIGATORIAS) ---
# Local: salida de `supabase status`. Producción: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Salta RLS: jamás en código de cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio (OBLIGATORIA) ---
# URL pública canónica (SEO, enlaces en correos). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tareas programadas (OBLIGATORIA en producción) ---
# Vercel Cron envía "Authorization: Bearer <CRON_SECRET>". Mínimo 16 caracteres.
# Genera uno con: openssl rand -hex 32
# Sin definir, /api/cron/* queda abierto solo fuera de producción.
CRON_SECRET=

# --- Staff ---
# Correos con rol super_admin en /admin, separados por coma.
ADMIN_EMAILS=

# --- IA (Anthropic) ---
# Sin clave, la IA degrada a modo sin credenciales sin romper la página.
ANTHROPIC_API_KEY=
# Opcional. Por defecto lo define lib/ia/cliente.ts.
ANTHROPIC_MODEL=
# Opcional. Tasa COP por USD para mostrar costos de IA en pesos.
TRM_COP_USD=

# --- Pagos ---
# Proveedor del adaptador de pasarela: "sandbox" (pruebas, sin cobros reales). Obligatorio en producción.
PAGOS_PROVEEDOR=sandbox
# Secreto para firmar los webhooks del sandbox. Obligatorio en producción si PAGOS_PROVEEDOR=sandbox. Mínimo 16 caracteres.
PAGOS_SANDBOX_SECRET=

# --- Datos legales del responsable (Ley 1581/2012) ---
# Se muestran en /terminos, /privacidad y /datos-personales.
# Si faltan, aparecen como "[… POR DEFINIR]". Complétalos antes de lanzar.
NEXT_PUBLIC_LEGAL_RAZON_SOCIAL=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_DOMICILIO=Barranquilla, Atlántico, Colombia
NEXT_PUBLIC_LEGAL_DIRECCION=
NEXT_PUBLIC_LEGAL_EMAIL_DATOS=
NEXT_PUBLIC_LEGAL_TELEFONO=

# --- Las define Vercel automáticamente (no configurar) ---
# VERCEL_GIT_COMMIT_SHA   → versión en /api/health

# --- Pruebas ---
# Base del smoke test HTTP (por defecto http://localhost:3000).
# SMOKE_BASE_URL=

# --- WhatsApp (plan, aún no se usan; ver docs/PLAN-WHATSAPP.md) ---
# WHATSAPP_PROVEEDOR=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_WEBHOOK_SECRET=
# WSP_PRESUPUESTO_DIARIO_USD=
# WSP_DEDUP_DIAS=30
